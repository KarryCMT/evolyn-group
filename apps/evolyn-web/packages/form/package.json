{
  "name": "@evolyn.do/form",
  "description": "Evolyn form schema, runtime and designer foundation",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./schema": {
      "types": "./dist/types/schema/index.d.ts",
      "import": "./dist/esm/schema/index.mjs",
      "require": "./dist/cjs/schema/index.js"
    },
    "./runtime-core": {
      "types": "./dist/types/runtime-core/index.d.ts",
      "import": "./dist/esm/runtime-core/index.mjs",
      "require": "./dist/cjs/runtime-core/index.js"
    },
    "./runtime-core/style.css": "./dist/runtime-core/style.css",
    "./runtime-web": {
      "types": "./dist/types/runtime-web/index.d.ts",
      "import": "./dist/esm/runtime-web/index.mjs",
      "require": "./dist/cjs/runtime-web/index.js"
    },
    "./runtime-web/style.css": "./dist/runtime-web/style.css",
    "./runtime-mobile": {
      "types": "./dist/types/runtime-mobile/index.d.ts",
      "import": "./dist/esm/runtime-mobile/index.mjs",
      "require": "./dist/cjs/runtime-mobile/index.js"
    },
    "./runtime-mobile/style.css": "./dist/runtime-mobile/style.css",
    "./designer": {
      "types": "./dist/types/designer/index.d.ts",
      "import": "./dist/esm/designer/index.mjs",
      "require": "./dist/cjs/designer/index.js"
    },
    "./style.css": "./dist/style.css",
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rimraf dist && tsdown",
    "clean": "rimraf .turbo node_modules dist",
    "publish": "pnpm publish",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@remixicon/vue": "catalog:ui",
    "element-plus": "catalog:ui",
    "vue": "catalog:frontend"
  },
  "devDependencies": {
    "@evolyn.do/typescript-config": "workspace:*",
    "@tsdown/css": "catalog:build",
    "@types/node": "catalog:types",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/test-utils": "catalog:test",
    "element-plus": "catalog:ui",
    "happy-dom": "catalog:test",
    "rimraf": "catalog:dev",
    "sass": "catalog:dev",
    "tsdown": "catalog:build",
    "typescript": "catalog:types",
    "unplugin-vue": "catalog:build",
    "vitest": "catalog:test",
    "vue": "catalog:frontend",
    "vue-tsc": "catalog:build"
  },
  "dependencies": {
    "@evolyn.do/ui": "workspace:*",
    "vuedraggable": "catalog:frontend"
  }
}
